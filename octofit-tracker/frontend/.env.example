# Required for Codespaces API access from the Vite frontend.
# Copy this file to `.env.local` and set your codespace name:
#
#   cp .env.example .env.local
#
# VITE_CODESPACE_NAME must be defined so the app can call:
#   https://${VITE_CODESPACE_NAME}-8000.app.github.dev/api/[component]
#
# If unset, the client safely falls back to http://localhost:8000
# (it will not generate https://undefined-8000.app.github.dev URLs).

VITE_CODESPACE_NAME=
